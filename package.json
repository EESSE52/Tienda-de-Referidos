{
  "name": "tienda-de-referidos",
  "version": "1.0.0",
  "description": "Tienda web para venta de articulos referidos",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "admin": "node scripts/admin-server.mjs",
    "test": "vitest run",
    "d1:export-seed": "node scripts/export-d1-seed.mjs",
    "ml:export": "node scripts/extract-mercadolibre-json.mjs",
    "python:install": "python3 -m pip install -r python-extractor/requirements.txt",
    "python:extract": "python3 python-extractor/cli.py",
    "python:app": "python3 python-extractor/main.py",
    "worker:dev": "npm run build && wrangler dev --config dist/server/wrangler.json --assets dist/client --port 8787 --persist-to .wrangler/state",
    "oauth:prepare-preview": "npm run build && node scripts/prepare-oauth-preview.mjs",
    "worker:deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "prebuild": "node scripts/preserve-dev-vars.mjs backup",
    "postbuild": "node scripts/preserve-dev-vars.mjs restore"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EESSE52/Tienda-de-Referidos.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/EESSE52/Tienda-de-Referidos/issues"
  },
  "homepage": "https://github.com/EESSE52/Tienda-de-Referidos#readme",
  "devDependencies": {
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.3.8",
    "tailwindcss": "^4.3.3",
    "xlsx": "^0.18.5"
  }
}
