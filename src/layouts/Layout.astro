---
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
  noindex?: boolean;
};

const { title = 'Comparador de productos', description = 'Compara precios, formatos y características de productos en Chile con D’MonkeySport.', noindex = false } = Astro.props as Props;
const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(currentPath, 'https://dmonkeysport.com').toString();
const pageTitle = title === 'D’MonkeySport' ? title : `${title} | D’MonkeySport`;
---

<!doctype html>
<html lang="es" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="D’MonkeySport" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-full bg-slate-50 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <header class="border-b border-slate-200 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-900/90">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4">
        <a href="/" class="text-xl font-black tracking-tight text-slate-900 dark:text-white">D’MonkeySport</a>
        <nav class="hidden items-center gap-4 text-sm font-medium md:flex" aria-label="Navegación principal">
          <a href="/" class={currentPath === '/' ? 'text-emerald-600 dark:text-emerald-400' : 'text-slate-600 dark:text-slate-300'}>Inicio</a>
          <a href="/#categorias" class="text-slate-600 dark:text-slate-300">Categorías</a>
          <a href="/como-comparamos" class={currentPath === '/como-comparamos' ? 'text-emerald-600 dark:text-emerald-400' : 'text-slate-600 dark:text-slate-300'}>Cómo comparamos</a>
          <a href="/aviso-afiliados" class={currentPath === '/aviso-afiliados' ? 'text-emerald-600 dark:text-emerald-400' : 'text-slate-600 dark:text-slate-300'}>Afiliados</a>
        </nav>
        <details class="relative md:hidden" id="mobile-nav">
          <summary class="cursor-pointer rounded-lg border border-slate-300 px-3 py-2 text-sm font-bold text-slate-800 focus-visible:outline-2 focus-visible:outline-emerald-500 dark:border-slate-600 dark:text-slate-100">Menú</summary>
          <nav aria-label="Navegación móvil" class="absolute right-0 top-full z-50 mt-2 flex min-w-44 flex-col gap-1 rounded-xl border border-slate-200 bg-white p-2 shadow-xl dark:border-slate-700 dark:bg-slate-900">
            <a href="/" class="rounded-lg px-3 py-2 hover:bg-emerald-50 dark:hover:bg-slate-800">Inicio</a>
            <a href="/#categorias" class="rounded-lg px-3 py-2 hover:bg-emerald-50 dark:hover:bg-slate-800">Categorías</a>
            <a href="/como-comparamos" class="rounded-lg px-3 py-2 hover:bg-emerald-50 dark:hover:bg-slate-800">Cómo comparamos</a>
            <a href="/aviso-afiliados" class="rounded-lg px-3 py-2 hover:bg-emerald-50 dark:hover:bg-slate-800">Afiliados</a>
          </nav>
        </details>
      </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-8">
      <slot />
    </main>

    <footer class="border-t border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
      <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-6 text-sm text-slate-600 dark:text-slate-300 md:flex-row md:items-center md:justify-between">
        <p>Los enlaces son de afiliado y pueden generar una comisión sin costo adicional para ti.</p>
        <div class="flex items-center gap-4">
          <a href="/como-comparamos" class="font-medium text-emerald-600 dark:text-emerald-400">Ver metodología</a>
          <a href="/aviso-afiliados" class="font-medium text-emerald-600 dark:text-emerald-400">Aviso de afiliados</a>
        </div>
      </div>
    </footer>
    <script is:inline>
      (() => {
        // Conteo anónimo agregado: no usa cookies, almacenamiento ni identificadores.
        const send = (event, productId, placement) => {
          if (!productId || !/^[a-zA-Z0-9_-]{3,100}$/.test(productId)) return;
          const payload = JSON.stringify({ event, product_id: productId, placement });
          try {
            if (navigator.sendBeacon) {
              navigator.sendBeacon('/api/analytics/event', new Blob([payload], {type:'application/json'}));
            } else {
              fetch('/api/analytics/event', {method:'POST',headers:{'Content-Type':'application/json'},
                body:payload,keepalive:true,credentials:'omit'}).catch(() => {});
            }
          } catch { /* Las métricas nunca impiden navegar. */ }
        };
        const view = document.querySelector('[data-product-view]');
        if (view) send('view', view.getAttribute('data-product-view'), 'product');
        document.addEventListener('click', event => {
          const link = event.target.closest?.('a[data-affiliate-product]');
          if (!link || !/^https:\/\//i.test(link.href)) return;
          send('affiliate_click', link.dataset.affiliateProduct, link.dataset.affiliatePlacement || 'product');
        }, {capture: true});
      })();
    </script>
  </body>
</html>
