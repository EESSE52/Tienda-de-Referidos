---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404" description="La pagina que buscas no existe.">
  <section class="mx-auto max-w-3xl rounded-3xl border border-slate-200 bg-white p-8 text-center shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-emerald-600 dark:text-emerald-400">Error 404</p>
    <h1 class="mt-2 text-3xl font-black text-slate-900 dark:text-white">No encontramos esta pagina</h1>
    <p class="mt-4 text-slate-600 dark:text-slate-300">Puede que el enlace este desactualizado o que la pagina haya cambiado de ruta.</p>
    <a href="/" class="mt-6 inline-flex rounded-xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-700 dark:bg-emerald-500 dark:text-slate-950">Volver al inicio</a>
  </section>
</Layout>
