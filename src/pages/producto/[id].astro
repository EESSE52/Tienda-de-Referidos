---
import Layout from '../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
import { currencyCLP, currencyCLPUnit, getMetricResult, loadCatalog, productHasOldPrice } from '../../lib/catalog';
import { formatMetricValue } from '../../lib/metricas';
import { dateLabel } from '../../lib/format';
import { AVISO_AFILIADOS_BREVE, getPrecioReferencialLabel, getPublicProductImage } from '../../lib/public-site';

const { id } = Astro.params;
const catalog = await loadCatalog(env?.CATALOG_DB);
const producto = catalog.getProductoById(String(id));
if (!producto) {
  throw new Error('Producto no encontrado');
}

const lista = catalog.getListaById(producto.lista_id);
const metricRows = lista?.metricas.map((metrica) => ({
  ...metrica,
  valor: getMetricResult(producto, metrica),
})) ?? [];
const priceIsOld = productHasOldPrice(producto.fecha_precio);
const hasAffiliateLink = /^https:\/\//i.test(String(producto.enlace_referido || ''));
const isPublicOffer = producto.activo === true;
const mainCostMetrics = metricRows.filter((metrica) => {
  const formula = metrica.plantilla ?? metrica.formula;
  return formula?.tipo === 'precio_dividido_por' && metrica.valor !== null && Number.isFinite(metrica.valor);
}).slice(0, 3);
const imageIsGeneric = !producto.imagen_propia;
const offerStatusLabel = producto.estado_oferta === 'disponible'
  ? 'Oferta registrada como disponible'
  : producto.estado_oferta === 'no_disponible'
    ? 'Oferta registrada como no disponible'
    : 'Disponibilidad sin verificar';
const displaySeller = producto.vendedor_nombre || producto.vendedor || '—';
const attributeEntries = Object.entries(producto.atributos ?? {}).filter(([, value]) => value !== undefined && value !== null && value !== '').map(([key, value]) => ({
  key, value,
  field: lista?.campos.find((campo) => campo.clave === key),
}));
const metricDisplay = (metrica: { etiqueta?: string; decimales?: number; plantilla?: { tipo?: string }; formula?: { tipo?: string } }, value: number | null) => {
  if (value === null || value === undefined || !Number.isFinite(value)) return 'No disponible';
  const label = String(metrica?.etiqueta || '').toLowerCase();
  const isPriceMetric = label.includes('precio') || label.includes('costo') || label.includes('coste');
  if (isPriceMetric || metrica?.plantilla?.tipo === 'precio_dividido_por' || metrica?.formula?.tipo === 'precio_dividido_por') {
    return currencyCLPUnit(value);
  }
  return `${formatMetricValue(value, metrica?.decimales ?? 2)}`;
};
---

<Layout title={producto.nombre} description={`${producto.marca} - ${producto.nombre}. Comparación y precio de referencia.`}>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <div class="mb-5 flex flex-wrap items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
      <a href="/" class="transition hover:text-emerald-600">Inicio</a>
      <span>/</span>
      {lista ? <a href={`/lista/${lista.slug}`} class="transition hover:text-emerald-600">{lista.nombre}</a> : <span>Lista</span>}
      <span>/</span>
      <span class="text-slate-700 dark:text-slate-200">{producto.nombre}</span>
    </div>

    <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1.25fr)_minmax(300px,0.75fr)]">
      <section class="min-w-0 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7 dark:border-slate-800 dark:bg-slate-900">
        <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-emerald-600 dark:text-emerald-400">
          <span>{lista?.nombre ?? 'Lista'}</span>
          {producto.activo ? <span class="rounded-full bg-emerald-50 px-2 py-1 text-[10px] text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300">Activo</span> : <span class="rounded-full bg-slate-200 px-2 py-1 text-[10px] text-slate-700 dark:bg-slate-700 dark:text-slate-200">Inactivo</span>}
        </div>

        <h1 class="mt-3 text-3xl font-black leading-tight tracking-tight text-slate-900 sm:text-4xl dark:text-white">{producto.nombre}</h1>
        <p class="mt-2 text-lg text-slate-600 dark:text-slate-300">{producto.marca || 'Marca no indicada'}</p>

        <figure class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-gradient-to-br from-white via-emerald-50/40 to-slate-100 dark:border-slate-700 dark:from-slate-900 dark:via-slate-800 dark:to-slate-900">
          <img src={getPublicProductImage(producto)} alt={`Imagen referencial de ${producto.nombre}`} loading="lazy" width="1200" height="800" class="aspect-[4/3] h-auto w-full object-contain p-4 sm:p-8" />
          {imageIsGeneric && <figcaption class="border-t border-slate-200 bg-white/80 px-4 py-2 text-center text-xs text-slate-500 dark:border-slate-700 dark:bg-slate-900/80 dark:text-slate-300">Imagen genérica de la categoría; no representa el envase comercial.</figcaption>}
        </figure>

        <div class="mt-6 rounded-2xl border border-emerald-100 bg-emerald-50/70 p-5 sm:p-6 dark:border-emerald-900 dark:bg-emerald-950/30">
          <p class="text-sm font-semibold text-emerald-900 dark:text-emerald-200">Precio referencial registrado</p>
          <div class="mt-2 flex flex-wrap items-end gap-3">
            <span class="text-4xl font-black tracking-tight text-slate-900 sm:text-5xl dark:text-white">{currencyCLP(producto.precio)}</span>
            <span class="text-sm text-slate-500 dark:text-slate-300">{dateLabel(producto.fecha_precio)}</span>
          </div>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{getPrecioReferencialLabel(producto.fecha_precio)}</p>
          <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Precio y disponibilidad sujetos a cambios. Compruébalos en la tienda antes de comprar.</p>
          {mainCostMetrics.length > 0 && (
            <div class="mt-5 grid gap-3 sm:grid-cols-3" aria-label="Costos unitarios del producto">
              {mainCostMetrics.map((metrica) => (
                <div class="rounded-xl border border-emerald-100 bg-white p-3 dark:border-emerald-900 dark:bg-slate-900">
                  <p class="text-xs font-medium leading-snug text-slate-600 dark:text-slate-300">{metrica.etiqueta}</p>
                  <p class="mt-1 text-xl font-extrabold tabular-nums text-emerald-800 dark:text-emerald-300">{metricDisplay(metrica, metrica.valor)}</p>
                </div>
              ))}
            </div>
          )}

          <div class="mt-4 flex flex-wrap gap-2 text-sm">
            <span class="rounded-full bg-white px-3 py-1 text-slate-700 shadow-sm dark:bg-slate-700 dark:text-slate-100">{displaySeller}</span>
            <span class="rounded-full bg-white px-3 py-1 text-slate-700 shadow-sm dark:bg-slate-700 dark:text-slate-100">{producto.id_publicacion || 'Sin ID'}</span>
            {producto.tienda_oficial ? <span class="rounded-full bg-white px-3 py-1 text-slate-700 shadow-sm dark:bg-slate-700 dark:text-slate-100">Tienda oficial</span> : null}
            {producto.envio_gratis ? <span class="rounded-full bg-white px-3 py-1 text-slate-700 shadow-sm dark:bg-slate-700 dark:text-slate-100">Envio gratis</span> : null}
            {producto.despacho_full ? <span class="rounded-full bg-white px-3 py-1 text-slate-700 shadow-sm dark:bg-slate-700 dark:text-slate-100">Despacho Full</span> : null}
            {producto.mercadolider ? <span class="rounded-full bg-white px-3 py-1 text-slate-700 shadow-sm dark:bg-slate-700 dark:text-slate-100">MercadoLider {producto.mercadolider}</span> : null}
          </div>

          {priceIsOld && (
            <div class="mt-4 rounded-xl border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-800 dark:border-amber-700 dark:bg-amber-950/40 dark:text-amber-200">
              Precio posiblemente desactualizado.
            </div>
          )}
        </div>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          {hasAffiliateLink && isPublicOffer ? (
            <a href={producto.enlace_referido} target="_blank" rel="sponsored nofollow noopener" aria-label={`Ver oferta de ${producto.nombre} en tienda externa`} class="inline-flex min-h-12 flex-1 items-center justify-center rounded-xl bg-emerald-600 px-5 py-3 text-center text-sm font-bold text-white shadow-sm transition hover:bg-emerald-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600">Ver oferta en Mercado Libre ↗</a>
          ) : (
            <span class="inline-flex min-h-12 flex-1 items-center justify-center rounded-xl bg-slate-200 px-5 py-3 text-center text-sm font-semibold text-slate-600 dark:bg-slate-800 dark:text-slate-300">Oferta no disponible para compra desde aquí</span>
          )}
          <a href={lista ? `/lista/${lista.slug}` : '/'} class="inline-flex min-h-12 items-center justify-center rounded-xl border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-500 dark:border-slate-700 dark:text-slate-200">← Volver a la lista</a>
        </div>
        <p class="mt-4 text-sm text-slate-600 dark:text-slate-300">{AVISO_AFILIADOS_BREVE}</p>
      </section>

      <aside class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white">Resumen</h2>
        <dl class="mt-4 space-y-3 text-sm">
          <div class="flex items-center justify-between gap-4"><dt class="text-slate-500 dark:text-slate-300">Marca</dt><dd class="font-medium text-slate-900 dark:text-white">{producto.marca || 'Sin marca'}</dd></div>
          <div class="flex items-center justify-between gap-4"><dt class="text-slate-500 dark:text-slate-300">Vendedor</dt><dd class="font-medium text-slate-900 dark:text-white">{displaySeller}</dd></div>
          <div class="flex items-center justify-between gap-4"><dt class="text-slate-500 dark:text-slate-300">ID</dt><dd class="font-medium text-slate-900 dark:text-white">{producto.id_publicacion || 'Sin ID'}</dd></div>
          <div class="flex items-center justify-between gap-4"><dt class="text-slate-500 dark:text-slate-300">Disponibilidad</dt><dd class="text-right font-medium text-slate-900 dark:text-white">{offerStatusLabel}</dd></div>
        </dl>

        {producto.notas && (
          <div class="mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-800">
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500 dark:text-slate-300">Nota</p>
            <p class="mt-2 text-sm text-slate-700 dark:text-slate-200">{producto.notas}</p>
          </div>
        )}
      </aside>
    </div>

    <section class="mt-8 grid gap-6 lg:grid-cols-2">
      <div class="rounded-3xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white">Costos y métricas de comparación</h2>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Valores calculados con el precio referencial y las características registradas. No constituyen una cotización actualizada.</p>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          {metricRows.length > 0 ? metricRows.map((metrica) => (
            <div class="rounded-2xl bg-slate-50 p-4 dark:bg-slate-800">
              <p class="text-sm text-slate-500 dark:text-slate-300">{metrica.etiqueta}</p>
              <strong class="mt-2 block text-lg font-bold text-slate-900 dark:text-white">{metricDisplay(metrica, metrica.valor)}</strong>
            </div>
          )) : <p class="text-slate-500 dark:text-slate-400 sm:col-span-2">No hay métricas definidas para esta lista.</p>}
        </div>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white">Atributos</h2>
        {attributeEntries.length > 0 ? (
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            {attributeEntries.map(({ key, value, field }) => (
              <div class="rounded-2xl bg-slate-50 p-3 text-sm dark:bg-slate-800">
                <p class="text-slate-500 dark:text-slate-300">{field?.etiqueta || key}</p>
                <p class="mt-1 font-medium text-slate-900 dark:text-white">{String(value)} {field?.unidad || ""}</p>
              </div>
            ))}
          </div>
        ) : (
          <p class="mt-4 text-slate-500 dark:text-slate-400">Todavía no hay atributos cargados para este producto.</p>
        )}
      </div>
    </section>
  </div>
</Layout>
