---
import Layout from '../../layouts/Layout.astro';
import { currencyCLP, getListaBySlug, getProductosByListaId, getMetricResult, productHasOldPrice } from '../../lib/catalog';
import { formatMetricValue } from '../../lib/metricas';

export async function getStaticPaths() {
  const { listas } = await import('../../lib/catalog');
  return listas.map((lista) => ({ params: { slug: lista.slug }, props: { lista } }));
}

const { slug } = Astro.params;
const lista = getListaBySlug(String(slug));
if (!lista) {
  throw new Error('Lista no encontrada');
}

const productos = getProductosByListaId(lista.id);
const filterFields = lista.campos.filter((campo) => campo.filtrable);
const comparisonUrl = productos.length >= 2 ? `/comparador?ids=${productos.slice(0, Math.min(4, productos.length)).map((producto) => producto.id).join(',')}` : '/comparador';

const formatMetricValueForDisplay = (metrica: any, valor: number | null) => {
  if (valor === null || Number.isNaN(valor)) return '—';
  const key = String(metrica?.clave || '').toLowerCase();
  const label = String(metrica?.etiqueta || '').toLowerCase();
  const isMonetary = key.includes('precio') || label.includes('precio') || metrica?.formula?.tipo === 'precio_dividido_por';
  return isMonetary ? currencyCLP(Number(valor)) : formatMetricValue(Number(valor), Number(metrica?.decimales ?? 2));
};
---

<Layout title={lista.nombre} description={lista.descripcion}>
  <section class="mb-6 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-emerald-600 dark:text-emerald-400">{lista.id}</p>
    <h1 class="mt-2 text-3xl font-black">{lista.nombre}</h1>
    <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-300">{lista.descripcion}</p>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href={comparisonUrl} class="rounded-xl bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-500">Comparar 2–4 productos</a>
    </div>
  </section>

  {filterFields.length > 0 && (
    <section class="mb-6 rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="mb-3 text-lg font-bold">Filtros</h2>
      <div class="grid gap-3 md:grid-cols-3 xl:grid-cols-5">
        {filterFields.map((campo) => (
          <label class="block text-sm text-slate-700 dark:text-slate-200">
            <span class="mb-1 block font-medium">{campo.etiqueta}</span>
            <select data-filter-field={campo.clave} class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 outline-none focus:border-emerald-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
              <option value="">Todos</option>
              {campo.opciones?.map((opcion) => (
                <option value={opcion}>{opcion}</option>
              ))}
            </select>
          </label>
        ))}
      </div>
    </section>
  )}

  <section class="mb-4 rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <label class="block w-full max-w-md text-sm text-slate-700 dark:text-slate-200">
        <span class="mb-1 block font-medium">Buscar producto</span>
        <input id="search-input" type="search" placeholder="Nombre, marca o atributo" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 outline-none focus:border-emerald-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
      </label>
      <label class="block text-sm text-slate-700 dark:text-slate-200">
        <span class="mb-1 block font-medium">Ordenar por</span>
        <select id="sort-field" class="w-full max-w-xs rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 outline-none focus:border-emerald-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
          <option value="precio">Precio</option>
          {lista.metricas.map((metrica) => (
            <option value={metrica.clave}>{metrica.etiqueta}</option>
          ))}
        </select>
      </label>
    </div>
  </section>

  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <div class="overflow-x-auto">
      <table class="min-w-full table-auto text-left">
        <thead class="bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-100">
          <tr>
            <th class="px-4 py-3"><span class="sr-only">Seleccionar</span></th>
            <th class="px-4 py-3 font-semibold">Producto</th>
            <th class="px-4 py-3 font-semibold">Marca</th>
            <th class="px-4 py-3 font-semibold">Precio</th>
            {lista.metricas.map((metrica) => (
              <th class="px-4 py-3 font-semibold">{metrica.etiqueta}</th>
            ))}
            {lista.campos.filter((campo) => campo.en_tabla).map((campo) => (
              <th class="px-4 py-3 font-semibold">{campo.etiqueta}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {productos.map((producto) => (
            <tr class="border-t border-slate-200 text-sm dark:border-slate-800" data-row data-product-id={producto.id} data-price-value={producto.precio}>
              <td class="px-4 py-3">
                <input type="checkbox" class="compare-toggle h-4 w-4 rounded border-slate-400" value={producto.id} data-product-id={producto.id} />
              </td>
              <td class="px-4 py-3">
                <a href={`/producto/${producto.id}`} class="font-semibold text-emerald-600 hover:underline dark:text-emerald-400">{producto.nombre}</a>
                {productHasOldPrice(producto.fecha_precio) && (
                  <div class="mt-1 text-xs text-amber-700 dark:text-amber-300">Precio antiguo: revisa la fecha</div>
                )}
              </td>
              <td class="px-4 py-3">{producto.marca}</td>
              <td class="px-4 py-3 font-semibold">{currencyCLP(producto.precio)}</td>
              {lista.metricas.map((metrica) => {
                const valor = getMetricResult(producto, metrica);
                const isBest = metrica.mejor && valor !== null && (metrica.mejor === 'menor' ? valor === Math.min(...productos.map((p) => getMetricResult(p, metrica) ?? Infinity)) : valor === Math.max(...productos.map((p) => getMetricResult(p, metrica) ?? -Infinity)));
                return <td class={`px-4 py-3 ${isBest ? 'bg-emerald-100 text-emerald-900 dark:bg-emerald-950 dark:text-emerald-200' : ''}`} data-metric-key={metrica.clave} data-metric-value={valor ?? 'NaN'}>{formatMetricValueForDisplay(metrica, valor)}</td>;
              })}
              {lista.campos.filter((campo) => campo.en_tabla).map((campo) => (
                <td class="px-4 py-3" data-field={campo.clave}>{producto.atributos?.[campo.clave] ?? '—'}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div id="empty-state" class="hidden border-t border-slate-200 px-4 py-8 text-center text-sm text-slate-600 dark:border-slate-800 dark:text-slate-300">
      No hay productos que coincidan con la búsqueda o los filtros actuales.
    </div>
  </div>

  <script is:inline>
    const selected = new Set();
    const toggles = document.querySelectorAll('.compare-toggle');
    const filters = document.querySelectorAll('[data-filter-field]');
    const sortField = document.getElementById('sort-field');
    const searchInput = document.getElementById('search-input');
    const tableBody = document.querySelector('tbody');
    const emptyState = document.getElementById('empty-state');
    const rows = () => Array.from(tableBody?.querySelectorAll('[data-row]') ?? []);
    const metricDirections = {
      precio: 'menor',
      "price": 'menor'
    };

    {lista.metricas.map((metrica) => (
      `metricDirections["${metrica.clave}"] = "${metrica.mejor || 'menor'}";`
    ))}

    const getRowValue = (row, key) => {
      if (key === 'precio') {
        const value = Number(row.dataset.priceValue ?? Number.MAX_SAFE_INTEGER);
        return Number.isFinite(value) ? value : Number.MAX_SAFE_INTEGER;
      }
      const cell = row.querySelector(`[data-metric-key="${key}"]`);
      const raw = cell?.dataset.metricValue;
      const value = Number(raw);
      return Number.isFinite(value) ? value : Number.MAX_SAFE_INTEGER;
    };

    const refreshSort = () => {
      const key = sortField?.value || 'precio';
      const direction = metricDirections[key] === 'mayor' ? -1 : 1;
      const ordered = rows().sort((a, b) => {
        const aValue = getRowValue(a, key);
        const bValue = getRowValue(b, key);
        return (aValue - bValue) * direction;
      });
      ordered.forEach((row) => tableBody.appendChild(row));
    };

    const applyFilters = () => {
      const term = (searchInput?.value ?? '').trim().toLowerCase();
      let visibleCount = 0;
      rows().forEach((row) => {
        let visible = true;
        if (term) {
          visible = row.textContent.toLowerCase().includes(term);
        }
        filters.forEach((field) => {
          const key = field.getAttribute('data-filter-field');
          const value = field.value;
          if (!value) return;
          const cell = row.querySelector(`[data-field="${key}"]`);
          if (cell && cell.textContent.trim() !== value) {
            visible = false;
          }
        });
        row.style.display = visible ? '' : 'none';
        if (visible) visibleCount += 1;
      });
      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount > 0);
      }
    };

    const rebuildCompareLink = () => {
      const ids = [...selected].slice(0, 4);
      const button = document.querySelector('#compare-link');
      if (!button) return;
      button.href = ids.length >= 2 ? `/comparador?ids=${ids.join(',')}` : '/comparador';
      if (ids.length < 2) {
        button.classList.add('opacity-60');
      } else {
        button.classList.remove('opacity-60');
      }
    };

    toggles.forEach((toggle) => {
      toggle.addEventListener('change', () => {
        const id = toggle.value;
        if (toggle.checked) {
          if (selected.size >= 4) {
            toggle.checked = false;
            return;
          }
          selected.add(id);
        } else {
          selected.delete(id);
        }
        rebuildCompareLink();
      });
    });

    filters.forEach((field) => {
      field.addEventListener('change', applyFilters);
    });

    searchInput?.addEventListener('input', applyFilters);
    sortField?.addEventListener('change', refreshSort);
    refreshSort();

    const compareWidget = document.createElement('div');
    compareWidget.className = 'mt-6 flex justify-end';
    compareWidget.innerHTML = '<a id="compare-link" href="/comparador" class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white opacity-60 dark:bg-emerald-500 dark:text-slate-950">Comparar selección</a>';
    document.querySelector('table')?.parentElement?.parentElement?.appendChild(compareWidget);
    rebuildCompareLink();
  </script>
</Layout>
