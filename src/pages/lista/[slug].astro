---
import Layout from '../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
import { currencyCLP, currencyCLPUnit, getMetricResult, loadCatalog, productHasOldPrice } from '../../lib/catalog';
import { formatMetricValue } from '../../lib/metricas';
import { AVISO_AFILIADOS_BREVE, getPrecioReferencialLabel, getPublicProductImage } from '../../lib/public-site';
import { getGroupedListingProducts, getOffersForProduct } from '../../lib/product-offers';

const { slug } = Astro.params;
const catalog = await loadCatalog(env?.CATALOG_DB);
const lista = catalog.getListaBySlug(String(slug));
if (!lista) {
  throw new Error('Lista no encontrada');
}

const productos = getGroupedListingProducts(catalog.getProductosByListaId(lista.id));
const monetaryMetrics = lista.metricas.filter(metrica => metrica.plantilla?.tipo === 'precio_dividido_por' || metrica.formula?.tipo === 'precio_dividido_por');
const filterFields = lista.campos.filter((campo) => campo.filtrable);
const brands = [...new Set(productos.map(producto => String(producto.marca || '').trim()).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'es'));
const defaultSortField = lista.orden_defecto?.campo || 'precio';
const defaultSortDirection = lista.orden_defecto?.direccion || 'menor';

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: lista.nombre,
  description: lista.descripcion,
  itemListElement: productos.map((producto, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Product',
      name: producto.nombre,
      brand: producto.marca || undefined,
      offers: {
        '@type': 'Offer',
        priceCurrency: 'CLP',
        price: Number(producto.precio || 0),
      },
    },
  })),
};

const formatMetricValueForDisplay = (metrica: any, valor: number | null) => {
  if (valor === null || !Number.isFinite(valor)) return 'No disponible';
  const key = String(metrica?.clave || '').toLowerCase();
  const label = String(metrica?.etiqueta || '').toLowerCase();
  const isMonetary = key.includes('precio') || label.includes('precio') || metrica?.plantilla?.tipo === 'precio_dividido_por' || metrica?.formula?.tipo === 'precio_dividido_por';
  return isMonetary ? currencyCLPUnit(Number(valor)) : formatMetricValue(Number(valor), Number(metrica?.decimales ?? 2));
};
---

<Layout title={lista.nombre} description={lista.descripcion}>
  <script type="application/ld+json" set:html={JSON.stringify(itemListLd)} />
  <section id="lista-root" data-default-sort-field={defaultSortField} data-default-sort-direction={defaultSortDirection} data-metric-directions={JSON.stringify(Object.fromEntries(lista.metricas.map((m) => [m.clave, m.mejor || "menor"])))} class="mb-6 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-emerald-600 dark:text-emerald-400">{lista.id}</p>
    <h1 class="mt-2 text-3xl font-black">{lista.nombre}</h1>
    <p class="mt-3 inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1.5 text-sm font-semibold text-emerald-800 dark:bg-emerald-950 dark:text-emerald-200">{productos.length} {productos.length === 1 ? 'producto disponible' : 'productos disponibles'}</p>
    <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-300">{lista.descripcion}</p>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href="#productos" class="rounded-xl bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-500">Elegir productos para comparar</a>
    </div>
    <p class="mt-4 text-sm text-slate-600 dark:text-slate-300">{AVISO_AFILIADOS_BREVE}</p>
  </section>

  {filterFields.length > 0 && (
    <section class="mb-6 rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
      <h2 class="mb-3 text-lg font-bold">Filtros</h2>
      <div class="grid gap-3 md:grid-cols-3 xl:grid-cols-5">
        {filterFields.map((campo) => (
          <label class="block text-sm text-slate-700 dark:text-slate-200">
            <span class="mb-1 block font-medium">{campo.etiqueta}</span>
            <select data-filter-field={campo.clave} class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 outline-none focus:border-emerald-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
              <option value="">Todos</option>
              {campo.opciones?.map((opcion) => (
                <option value={opcion}>{opcion}</option>
              ))}
            </select>
          </label>
        ))}
      </div>
    </section>
  )}

  <section class="mb-4 rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <label class="block w-full max-w-md text-sm text-slate-700 dark:text-slate-200">
        <span class="mb-1 block font-medium">Buscar producto</span>
        <input id="search-input" type="search" placeholder="Nombre, marca o atributo" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 outline-none focus:border-emerald-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
      </label>
      <label class="block text-sm text-slate-700 dark:text-slate-200">
        <span class="mb-1 block font-medium">Ordenar por</span>
        <select id="sort-field" class="w-full max-w-xs rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 outline-none focus:border-emerald-500 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
          <option value="precio">Precio</option>
          {lista.metricas.map((metrica) => (
            <option value={metrica.clave}>{metrica.etiqueta}</option>
          ))}
        </select>
      </label>
      <label class="block text-sm text-slate-700 dark:text-slate-200">
        <span class="mb-1 block font-medium">Marca</span>
        <select id="brand-filter" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
          <option value="">Todas las marcas</option>
          {brands.map(marca => <option value={marca}>{marca}</option>)}
        </select>
      </label>
      <div class="text-sm text-slate-700 dark:text-slate-200">
        <span class="mb-1 block font-medium">Precio registrado (CLP)</span>
        <div class="flex gap-2">
          <input id="price-min" type="number" min="0" step="1" inputmode="numeric" placeholder="Mínimo" aria-label="Precio mínimo" class="w-1/2 min-w-0 rounded-lg border border-slate-300 bg-white px-2 py-2 text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
          <input id="price-max" type="number" min="0" step="1" inputmode="numeric" placeholder="Máximo" aria-label="Precio máximo" class="w-1/2 min-w-0 rounded-lg border border-slate-300 bg-white px-2 py-2 text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
        </div>
      </div>
      <div class="flex flex-wrap items-end gap-3 sm:col-span-2 lg:col-span-4">
        <p id="filter-count" role="status" aria-live="polite" class="text-sm text-slate-600 dark:text-slate-300">{productos.length} productos encontrados</p>
        <button id="reset-filters" type="button" class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 dark:border-slate-700 dark:text-slate-200">Limpiar filtros</button>
      </div>
    </div>
  </section>

  <section id="productos" class="grid gap-4 sm:grid-cols-2 lg:hidden" aria-label="Productos en tarjetas">
    {productos.map((producto) => (
      <article class="product-card overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900" data-card data-product-id={producto.id}>
        <a href={`/producto/${producto.id}`} class="block bg-slate-50 dark:bg-slate-800">
          <img src={getPublicProductImage(producto)} alt={`Imagen referencial: ${producto.nombre}`} loading="lazy" width="480" height="320" class="h-44 w-full object-contain p-3" />
        </a>
        <div class="space-y-3 p-4">
          <div>
            <p class="text-xs font-medium uppercase tracking-wide text-slate-500 dark:text-slate-300">{producto.marca || 'Marca no indicada'}</p>
            <a href={`/producto/${producto.id}`} class="mt-1 block font-bold text-slate-900 dark:text-white">{producto.nombre}</a>
            {getOffersForProduct(producto, catalog.productos).length > 1 && <p class="mt-2 text-xs font-semibold text-emerald-800 dark:text-emerald-300">{getOffersForProduct(producto, catalog.productos).length} ofertas de vendedores · desde {currencyCLP(producto.precio)}</p>}
          </div>
          <div>
            <p class="text-2xl font-black text-emerald-700 dark:text-emerald-400">{currencyCLP(producto.precio)}</p>
            <p class="text-xs text-slate-500 dark:text-slate-300">{getPrecioReferencialLabel(producto.fecha_precio)}</p>
            {productHasOldPrice(producto.fecha_precio) && <p class="text-xs text-amber-700 dark:text-amber-300">Precio posiblemente desactualizado</p>}
          </div>
          {monetaryMetrics.length > 0 && (
            <dl class="grid grid-cols-2 gap-2" aria-label="Costos unitarios calculados">
              {monetaryMetrics.slice(0, 2).map((metrica) => (
                <div class="rounded-xl border border-emerald-100 bg-emerald-50 p-3 dark:border-emerald-900 dark:bg-emerald-950/50">
                  <dt class="text-xs font-medium text-emerald-800 dark:text-emerald-300">{metrica.etiqueta}</dt>
                  <dd class="mt-1 text-lg font-extrabold tabular-nums text-emerald-900 dark:text-emerald-100">{formatMetricValueForDisplay(metrica, getMetricResult(producto, metrica))}</dd>
                </div>
              ))}
            </dl>
          )}
          <dl class="grid grid-cols-2 gap-2 text-xs">
            {lista.campos.filter(campo => campo.en_tabla && producto.atributos?.[campo.clave] !== undefined && producto.atributos?.[campo.clave] !== null && producto.atributos?.[campo.clave] !== '').slice(0, 4).map(campo => (
              <div class="rounded-lg bg-slate-50 p-2 dark:bg-slate-800">
                <dt class="text-slate-500 dark:text-slate-300">{campo.etiqueta}</dt>
                <dd class="mt-1 font-semibold text-slate-900 dark:text-white">{producto.atributos?.[campo.clave]} {campo.unidad || ''}</dd>
              </div>
            ))}
          </dl>
          <div class="flex items-center gap-2">
            <label class="flex flex-1 items-center gap-2 rounded-xl border border-slate-300 px-3 py-3 text-sm font-semibold dark:border-slate-700">
              <input class="compare-toggle h-5 w-5" type="checkbox" value={producto.id} aria-label={`Comparar ${producto.nombre}`} />
              Comparar
            </label>
            {/^https:\/\//i.test(String(producto.enlace_referido || '')) ? (
              <a href={producto.enlace_referido} data-affiliate-product={producto.id} data-affiliate-placement="category_card" target="_blank" rel="sponsored nofollow noopener" class="rounded-xl bg-emerald-600 px-4 py-3 text-sm font-semibold text-white">Ver oferta</a>
            ) : (
              <span class="rounded-xl bg-slate-100 px-3 py-3 text-xs text-slate-500 dark:bg-slate-800">Oferta pendiente</span>
            )}
          </div>
        </div>
      </article>
    ))}
  </section>
  <div class="lg:mt-0 mt-4 hidden overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900 lg:block">
    <div class="overflow-x-auto" role="region" aria-label="Catálogo de productos; desliza para ver métricas y usa la primera columna para seleccionar" tabindex="0">
      <table class="min-w-full table-auto text-left">
        <thead class="bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-100">
          <tr>
            <th scope="col" class="sticky left-0 z-20 bg-slate-100 px-4 py-3 dark:bg-slate-800"><span class="sr-only">Seleccionar</span></th>
            <th class="px-4 py-3 font-semibold">Producto</th>
            <th class="px-4 py-3 font-semibold">Marca</th>
            <th class="px-4 py-3 font-semibold">Precio</th>
            <th class="px-4 py-3 font-semibold">Oferta</th>
            {lista.metricas.map((metrica) => (
              <th class="px-4 py-3 font-semibold">{metrica.etiqueta}</th>
            ))}
            {lista.campos.filter((campo) => campo.en_tabla).map((campo) => (
              <th class="px-4 py-3 font-semibold">{campo.etiqueta}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {productos.map((producto) => (
            <tr class="border-t border-slate-200 text-sm dark:border-slate-800" data-row data-product-id={producto.id} data-price-value={producto.precio} data-brand-value={producto.marca || ''}>
              <td class="sticky left-0 z-10 bg-white px-4 py-3 dark:bg-slate-900">
                <input type="checkbox" class="compare-toggle h-5 w-5 rounded border-slate-400" value={producto.id} data-product-id={producto.id} aria-label={`Comparar ${producto.nombre}`} />
              </td>
              <td class="px-4 py-3">
                <a href={`/producto/${producto.id}`} class="font-semibold text-emerald-600 hover:underline dark:text-emerald-400">{producto.nombre}</a>
                {getOffersForProduct(producto, catalog.productos).length > 1 && <div class="mt-1 text-xs font-semibold text-emerald-800 dark:text-emerald-300">{getOffersForProduct(producto, catalog.productos).length} ofertas de vendedores</div>}
                {productHasOldPrice(producto.fecha_precio) && (
                  <div class="mt-1 text-xs text-amber-700 dark:text-amber-300">Precio posiblemente desactualizado</div>
                )}
              </td>
              <td class="px-4 py-3">{producto.marca}</td>
              <td class="px-4 py-3 font-semibold">
                <div class="whitespace-nowrap tabular-nums">{currencyCLP(producto.precio)}</div>
                <div class="text-xs font-normal text-slate-500 dark:text-slate-300">{getPrecioReferencialLabel(producto.fecha_precio)}</div>
              </td>
              <td class="px-4 py-3">
                {/^https:\/\//i.test(String(producto.enlace_referido || '')) ? (
                  <a href={producto.enlace_referido} data-affiliate-product={producto.id} data-affiliate-placement="category_table" target="_blank" rel="sponsored nofollow noopener" aria-label={`Ver oferta de ${producto.nombre} en Mercado Libre (sitio externo)`} class="inline-flex whitespace-nowrap rounded-lg bg-emerald-600 px-3 py-2 text-xs font-bold text-white transition hover:bg-emerald-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600">Ver oferta ↗</a>
                ) : (
                  <span class="text-xs text-slate-500 dark:text-slate-300">Oferta pendiente</span>
                )}
              </td>
              {lista.metricas.map((metrica) => {
                const valor = getMetricResult(producto, metrica);
                const isBest = productos.length > 1 && metrica.mejor && valor !== null && (metrica.mejor === 'menor' ? valor === Math.min(...productos.map((p) => getMetricResult(p, metrica) ?? Infinity)) : valor === Math.max(...productos.map((p) => getMetricResult(p, metrica) ?? -Infinity)));
                return <td class={`px-4 py-3 ${isBest ? 'bg-emerald-100 text-emerald-900 dark:bg-emerald-950 dark:text-emerald-200' : ''}`} data-metric-key={metrica.clave} data-metric-value={valor ?? 'NaN'}><span class="whitespace-nowrap tabular-nums font-semibold">{formatMetricValueForDisplay(metrica, valor)}</span></td>;
              })}
              {lista.campos.filter((campo) => campo.en_tabla).map((campo) => (
                <td class="px-4 py-3" data-field={campo.clave}>{producto.atributos?.[campo.clave] ?? '—'}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div id="empty-state" class="hidden border-t border-slate-200 px-4 py-8 text-center text-sm text-slate-600 dark:border-slate-800 dark:text-slate-300">
      No hay productos que coincidan con la búsqueda o los filtros actuales.
    </div>
  </div>

  <div id="compare-tray" hidden class="fixed inset-x-0 bottom-0 z-40 border-t border-emerald-200 bg-white/95 p-3 shadow-2xl backdrop-blur dark:border-slate-700 dark:bg-slate-950/95" aria-live="polite">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3">
      <div class="min-w-0 flex-1">
        <p id="compare-count" class="text-sm font-bold text-slate-900 dark:text-white">0 de 4 productos seleccionados</p>
        <div id="compare-chips" class="mt-2 flex flex-wrap gap-2"></div>
        <p id="compare-hint" class="mt-1 text-xs text-slate-600 dark:text-slate-300">Selecciona al menos 2 productos.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <button id="compare-clear" type="button" class="rounded-xl border border-slate-300 px-3 py-3 text-sm font-semibold dark:border-slate-700">Limpiar</button>
        <a id="compare-link" href="/comparador" aria-disabled="true" tabindex="-1" class="pointer-events-none rounded-xl bg-emerald-600 px-4 py-3 text-sm font-semibold text-white opacity-50">Comparar productos</a>
      </div>
    </div>
  </div>
  <script is:inline>
    const selected = new Set();
    const toggles = document.querySelectorAll('.compare-toggle');
    const cards = Array.from(document.querySelectorAll('[data-card]'));
    const filters = document.querySelectorAll('[data-filter-field]');
    const sortField = document.getElementById('sort-field');
    const searchInput = document.getElementById('search-input');
    const brandFilter = document.getElementById('brand-filter');
    const priceMin = document.getElementById('price-min');
    const priceMax = document.getElementById('price-max');
    const resetFilters = document.getElementById('reset-filters');
    const filterCount = document.getElementById('filter-count');
    const tableBody = document.querySelector('tbody');
    const emptyState = document.getElementById('empty-state');
    const listRoot = document.getElementById('lista-root');
    const rows = () => Array.from(tableBody?.querySelectorAll('[data-row]') ?? []);
    const metricDirections = {
      precio: 'menor',
      ...JSON.parse(listRoot?.dataset.metricDirections || '{}'),
    };

    const getRowValue = (row, key) => {
      if (key === 'precio') {
        const value = Number(row.dataset.priceValue ?? Number.MAX_SAFE_INTEGER);
        return Number.isFinite(value) ? value : Number.MAX_SAFE_INTEGER;
      }
      const cell = row.querySelector(`[data-metric-key="${key}"]`);
      const raw = cell?.dataset.metricValue;
      const value = Number(raw);
      return raw && Number.isFinite(value) ? value : null;
    };

    const refreshSort = () => {
      const key = sortField?.value || 'precio';
      const direction = metricDirections[key] === 'mayor' ? -1 : 1;
      const ordered = rows().sort((a, b) => {
        const aValue = getRowValue(a, key);
        const bValue = getRowValue(b, key);
        if (aValue === null) return bValue === null ? 0 : 1;
        if (bValue === null) return -1;
        return (aValue - bValue) * direction;
      });
      ordered.forEach((row) => tableBody.appendChild(row));
      const order = new Map(ordered.map((row, index) => [row.dataset.productId, index]));
      cards.forEach(card => { card.style.order = String(order.get(card.dataset.productId) ?? 999999); });
    };

    const applyFilters = () => {
      const term = (searchInput?.value ?? '').trim().toLowerCase();
      const brand = brandFilter?.value || '';
      const minPrice = priceMin?.value === '' ? null : Number(priceMin?.value);
      const maxPrice = priceMax?.value === '' ? null : Number(priceMax?.value);
      let visibleCount = 0;
      rows().forEach((row) => {
        let visible = true;
        if (term) {
          visible = row.textContent.toLowerCase().includes(term);
        }
        if (brand && row.dataset.brandValue !== brand) visible = false;
        const price = Number(row.dataset.priceValue);
        if (minPrice !== null && Number.isFinite(minPrice) && (!Number.isFinite(price) || price < minPrice)) visible = false;
        if (maxPrice !== null && Number.isFinite(maxPrice) && (!Number.isFinite(price) || price > maxPrice)) visible = false;
        filters.forEach((field) => {
          const key = field.getAttribute('data-filter-field');
          const value = field.value;
          if (!value) return;
          const cell = row.querySelector(`[data-field="${key}"]`);
          if (cell && cell.textContent.trim() !== value) {
            visible = false;
          }
        });
        row.style.display = visible ? '' : 'none';
        cards.filter(card => card.dataset.productId === row.dataset.productId).forEach(card => { card.hidden = !visible; card.classList.toggle('hidden', !visible); });
        if (visible) visibleCount += 1;
      });
      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount > 0);
      }
      if (filterCount) filterCount.textContent = visibleCount + (visibleCount === 1 ? ' producto encontrado' : ' productos encontrados');
    };

    const compareTray = document.getElementById('compare-tray');
    const compareLink = document.getElementById('compare-link');
    const compareCount = document.getElementById('compare-count');
    const compareHint = document.getElementById('compare-hint');
    const compareChips = document.getElementById('compare-chips');
    const compareClear = document.getElementById('compare-clear');
    const syncCompare = () => {
      const ids = [...selected];
      compareTray.hidden = ids.length === 0;
      document.body.style.paddingBottom = ids.length ? '170px' : '';
      compareCount.textContent = ids.length + ' de 4 productos seleccionados';
      compareHint.textContent = ids.length >= 2 ? 'Ya puedes comparar los productos seleccionados.' : 'Selecciona al menos 2 productos.';
      compareLink.href = ids.length >= 2 ? '/comparador?ids=' + ids.map(encodeURIComponent).join(',') : '/comparador';
      compareLink.setAttribute('aria-disabled', String(ids.length < 2));
      compareLink.tabIndex = ids.length >= 2 ? 0 : -1;
      compareLink.classList.toggle('pointer-events-none', ids.length < 2);
      compareLink.classList.toggle('opacity-50', ids.length < 2);
      toggles.forEach(toggle => { toggle.checked = selected.has(toggle.value); });
      compareChips.replaceChildren();
      for (const id of ids) {
        const product = [...toggles].find(toggle => toggle.value === id);
        const name = document.querySelector('[data-row][data-product-id="' + CSS.escape(id) + '"] td:nth-child(2) a')?.textContent?.trim() || id;
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'rounded-full border border-emerald-300 px-3 py-1 text-xs font-medium dark:border-emerald-700';
        chip.textContent = 'Quitar: ' + name;
        chip.setAttribute('aria-label', 'Quitar ' + name + ' de la comparación');
        chip.addEventListener('click', () => {
          selected.delete(id);
          toggles.forEach(toggle => { if (toggle.value === id) toggle.checked = false; });
          syncCompare();
        });
        compareChips.appendChild(chip);
      }
    };
    toggles.forEach(toggle => {
      toggle.addEventListener('change', () => {
        if (toggle.checked) {
          if (selected.size >= 4) {
            toggle.checked = false;
            compareHint.textContent = 'Puedes comparar un máximo de 4 productos.';
            return;
          }
          selected.add(toggle.value);
        } else {
          selected.delete(toggle.value);
        }
        syncCompare();
      });
    });
    compareClear.addEventListener('click', () => {
      selected.clear();
      toggles.forEach(toggle => { toggle.checked = false; });
      syncCompare();
    });
    compareLink.addEventListener('click', event => {
      if (selected.size < 2) event.preventDefault();
    });

    filters.forEach((field) => {
      field.addEventListener('change', applyFilters);
    });

    searchInput?.addEventListener('input', applyFilters);
    brandFilter?.addEventListener('change', applyFilters);
    priceMin?.addEventListener('input', applyFilters);
    priceMax?.addEventListener('input', applyFilters);
    resetFilters?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (brandFilter) brandFilter.value = '';
      if (priceMin) priceMin.value = '';
      if (priceMax) priceMax.value = '';
      filters.forEach(field => { field.value = ''; });
      applyFilters();
    });
    if (sortField) {
      const initialSortField = listRoot?.dataset.defaultSortField || 'precio';
      if (Array.from(sortField.options).some((option) => option.value === initialSortField)) {
        sortField.value = initialSortField;
      } else {
        sortField.value = 'precio';
      }
      if (sortField.value === 'precio') {
        metricDirections.precio = listRoot?.dataset.defaultSortDirection || 'menor';
      }
    }
    sortField?.addEventListener('change', refreshSort);
    refreshSort();
    applyFilters();

    syncCompare();
  </script>
</Layout>
