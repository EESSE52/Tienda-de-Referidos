---
import Layout from '../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
import { getPublishedGuides } from '../../lib/seo-guides.js';
const guides = await getPublishedGuides(env?.CATALOG_DB);
---
<Layout title="Guías y comparativas de suplementos" description="Guías gratuitas para comparar suplementos por precio, cantidad y costo por porción en Chile.">
  <section class="mb-8 rounded-3xl bg-[#ffe600] p-8 text-slate-950">
    <p class="text-sm font-extrabold uppercase tracking-wider">D’MonkeySport · Aprende a comparar</p>
    <h1 class="mt-3 text-4xl font-black">Guías y comparativas</h1>
    <p class="mt-3 max-w-2xl">Información clara para comparar suplementos y verificar las condiciones de compra antes de elegir.</p>
  </section>
  <section class="grid gap-5 md:grid-cols-2" aria-label="Artículos disponibles">
    {guides.map(guide => <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <p class="text-xs font-bold uppercase text-blue-700">{guide.category}</p>
      <h2 class="mt-2 text-xl font-black"><a class="hover:text-blue-700" href={`/guias/${guide.slug}`}>{guide.title}</a></h2>
      <p class="mt-3 text-sm text-slate-600">{guide.description}</p>
      <a class="mt-5 inline-block rounded-xl bg-blue-600 px-4 py-2 text-sm font-bold text-white" href={`/guias/${guide.slug}`}>Leer guía →</a>
    </article>)}
  </section>
  <p class="mt-8 text-sm text-slate-600">Estos contenidos son informativos. Los enlaces comerciales pueden generar una comisión sin costo adicional.</p>
</Layout>