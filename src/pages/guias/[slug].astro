---
import Layout from '../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
import { getPublishedGuides, validGuideSlug } from '../../lib/seo-guides.js';
import { editorialExtras } from '../../lib/seo-editorial.js';
import { loadCatalog, currencyCLP } from '../../lib/catalog';
import { getPublicProductImage } from '../../lib/public-site';
import { selectGuidePhotos } from '../../lib/guide-media.js';
export const prerender = false;
const slug = String(Astro.params.slug ?? '');
const guides = await getPublishedGuides(env?.CATALOG_DB);
const guide = validGuideSlug(slug) ? guides.find(g => g.slug === slug) : null;
if (!guide) return Astro.redirect('/guias', 302);
const listUrl = `/lista/${encodeURIComponent(guide.listSlug || 'creatina')}`;
const extra = editorialExtras[slug];
const catalog = await loadCatalog(env?.CATALOG_DB);
const targetList = catalog.getListaBySlug(guide.listSlug || 'creatina');
const products = (targetList ? catalog.getProductosByListaId(targetList.id) : [])
  .filter(p => p.activo === true && p.es_prueba !== true)
  .sort((a,b) => Number(Boolean(a.imagen_propia))-Number(Boolean(b.imagen_propia)))
  .reverse().slice(0,3);
const selectedPhoto = selectGuidePhotos(guides, catalog).get(slug);
const featured = selectedPhoto?.product || null;
const featuredImage = selectedPhoto?.image || null;
---
<Layout title={guide.title} description={guide.description}>
  <article class="mx-auto max-w-3xl rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-10">
    <nav aria-label="Ruta de navegación" class="mb-5 text-sm"><a href="/guias" class="font-semibold text-blue-700 hover:underline">← Todas las guías</a></nav>
    <p class="text-xs font-extrabold uppercase tracking-wide text-blue-700">{guide.category}</p>
    <h1 class="mt-3 text-3xl font-black leading-tight sm:text-4xl">{guide.title}</h1>
    <p class="mt-4 text-lg text-slate-600">{guide.description}</p>
    <p class="mt-3 text-xs text-slate-500">Actualizada: {guide.updatedAt}</p>
    {featured && featuredImage && (
      <figure class="mt-7 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
        <a href={`/producto/${encodeURIComponent(featured.id)}`} class="block">
          <img src={featuredImage} loading="lazy" width="960" height="560" alt={`Producto del catálogo: ${featured.nombre}`} class="mx-auto h-64 w-full object-contain p-4 sm:h-80" />
        </a>
        <figcaption class="border-t border-slate-200 bg-white px-4 py-3 text-xs text-slate-600">
          {featuredImage.startsWith('/img/generica-') ? 'Ilustración genérica de la categoría; no representa el envase real.' : 'Fotografía del producto registrada en el catálogo.'}
          {' '}<a class="font-semibold text-blue-700 underline" href={`/producto/${encodeURIComponent(featured.id)}`}>Ver ficha de {featured.nombre}</a>.
        </figcaption>
      </figure>
    )}
    {extra?.takeaway && <div class="mt-7 rounded-2xl border-l-4 border-blue-700 bg-blue-50 p-5"><h2 class="font-black text-slate-900">En resumen</h2><p class="mt-2 text-slate-800">{extra.takeaway}</p></div>}
    <div class="mt-8 space-y-5 text-base leading-8 text-slate-800">
      {guide.paragraphs.map(paragraph => <p>{paragraph}</p>)}
    </div>
    {extra && <div class="mt-9 space-y-9">
      {extra.sections.map(section => <section class="border-t border-slate-200 pt-7">
        <h2 class="text-2xl font-black text-slate-950">{section.heading}</h2>
        {section.paragraphs?.map(p => <p class="mt-4 leading-8 text-slate-700">{p}</p>)}
        {section.points && <ul class="mt-4 list-disc space-y-2 pl-6 leading-7 text-slate-700">{section.points.map(p => <li>{p}</li>)}</ul>}
        {section.example && <div class="mt-5 overflow-x-auto rounded-xl border border-slate-200">
          <table class="min-w-full text-left text-sm">
            <thead class="bg-slate-100"><tr><th class="p-3">Ejemplo</th><th class="p-3">Cantidad</th><th class="p-3">Precio</th><th class="p-3">Costo unitario</th></tr></thead>
            <tbody>{section.example.map(row => <tr class="border-t border-slate-200"><td class="p-3">{row.name}</td><td class="p-3">{row.amount}</td><td class="p-3">{row.price}</td><td class="p-3 font-bold">{row.perUnit}</td></tr>)}</tbody>
          </table>
          <p class="bg-slate-50 p-3 text-xs text-slate-500">Valores hipotéticos solo para enseñar a comparar; no corresponden a ofertas vigentes.</p>
        </div>}
      </section>)}
      <section class="border-t border-slate-200 pt-7">
        <h2 class="text-2xl font-black text-slate-950">Preguntas frecuentes</h2>
        {extra.faqs.map(item => <div class="mt-5"><h3 class="font-bold text-slate-900">{item.q}</h3><p class="mt-2 leading-7 text-slate-700">{item.a}</p></div>)}
      </section>
    </div>}
    {products.length > 0 && <section aria-label="Productos de esta categoría" class="mt-10">
      <div class="flex flex-wrap items-center justify-between gap-3"><h2 class="text-2xl font-black">Productos para comparar</h2><a class="text-sm font-bold text-blue-700 underline" href={listUrl}>Ver toda la categoría</a></div>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        {products.map(p => <a href={`/producto/${encodeURIComponent(p.id)}`} class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm hover:border-blue-400">
          <img src={getPublicProductImage(p)} alt={getPublicProductImage(p).startsWith('/img/generica-') ? `Ilustración genérica para ${p.nombre}` : `Fotografía registrada de ${p.nombre}`} loading="lazy" width="360" height="240" class="h-36 w-full bg-slate-50 object-contain p-3"/>
          <div class="p-3"><h3 class="line-clamp-3 text-sm font-bold text-slate-900">{p.nombre}</h3><p class="mt-2 text-lg font-black text-blue-700">{currencyCLP(p.precio)}</p><p class="mt-1 text-xs text-slate-500">Precio registrado; verificar en tienda.</p></div>
        </a>)}
      </div>
    </section>}
    <aside class="mt-10 rounded-2xl border border-[#eedc00] bg-[#fff8c2] p-6">
      <h2 class="text-xl font-black">Compara productos reales</h2>
      <p class="mt-2 text-sm">Consulta el catálogo y comprueba el precio final y disponibilidad en la tienda.</p>
      <a class="mt-4 inline-block rounded-xl bg-blue-700 px-5 py-3 font-bold text-white hover:bg-blue-800" href={listUrl}>Ver productos y comparar →</a>
    </aside>
    <p class="mt-6 text-xs text-slate-500">Contenido educativo. D’MonkeySport puede recibir comisiones de afiliado. No realiza la venta final ni garantiza precios o stock.</p>
  </article>
</Layout>