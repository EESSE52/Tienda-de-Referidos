---
import Layout from '../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
import { currencyCLP, currencyCLPUnit, getBestMetricValue, getMetricResult, loadCatalog, productHasOldPrice } from '../lib/catalog';
import { formatMetricValue } from '../lib/metricas';
import { AVISO_AFILIADOS_BREVE, getPrecioReferencialLabel } from '../lib/public-site';
import { summarizeComparison } from '../lib/comparison-insights.js';

const catalog = await loadCatalog(env?.CATALOG_DB);
const ids = (Astro.url.searchParams.get('ids') ?? '')
  .split(',')
  .map((id) => id.trim())
  .filter(Boolean)
  .slice(0, 4);

const productos = [...new Set(ids)].map((id) => catalog.getProductoById(id)).filter((producto) => producto?.activo === true && producto?.es_prueba !== true) as Array<any>;
const insights = summarizeComparison(productos, catalog.listas);
const mixedLists = new Set(productos.map((producto) => producto.lista_id));
const unionMetrics = [...new Set(productos.flatMap((producto) => {
  const lista = catalog.getListaById(producto.lista_id);
  return lista?.metricas.map((metrica) => metrica.clave) ?? [];
}))];
const displayMetric = (metric: any, value: number | null): string => {
  if (value === null || !Number.isFinite(value)) return 'No disponible';
  const formula = metric?.plantilla ?? metric?.formula;
  return formula?.tipo === 'precio_dividido_por'
    ? currencyCLPUnit(value)
    : formatMetricValue(value, Math.max(0, Math.min(6, Number(metric?.decimales ?? 2))));
};
---

<Layout title="Comparador de productos" description="Comparación de 2 a 4 productos con precios y métricas objetivas." noindex={true}>
  <section class="mb-6 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
    <h1 class="text-3xl font-black">Comparador</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-300">Compara de 2 a 4 productos. En el teléfono puedes deslizar la tabla horizontalmente mientras los nombres de las métricas permanecen visibles.</p>
    {productos.length >= 2 && (
      <div class="mt-4 flex flex-wrap gap-3 text-sm">
        <span class="rounded-full bg-emerald-100 px-3 py-1 font-medium text-emerald-800 dark:bg-emerald-950 dark:text-emerald-200">{productos.length} productos</span>
        <span class="rounded-full bg-slate-100 px-3 py-1 font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-200">Precio promedio: {currencyCLP(productos.reduce((sum, producto) => sum + Number(producto.precio || 0), 0) / productos.length)}</span>
      </div>
    )}
    {mixedLists.size > 1 && (
      <div class="mt-4 rounded-xl border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-800 dark:border-amber-700 dark:bg-amber-950/40 dark:text-amber-200">
        Se mezclan listas distintas en la comparación; revisa que el criterio de comparación sea consistente.
      </div>
    )}
    <p class="mt-4 text-sm text-slate-600 dark:text-slate-300">{AVISO_AFILIADOS_BREVE}</p>
  </section>

  {productos.length >= 2 && (
    <section class="mb-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900" aria-labelledby="insights-title">
      <h2 id="insights-title" class="text-xl font-extrabold text-slate-900 dark:text-white">Análisis de la comparación</h2>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Conclusiones calculadas con datos del catálogo, sin puntuaciones comerciales ni ventas estimadas. Precios referenciales sujetos a verificación.</p>
      {!insights.comparable ? (
        <p class="mt-4 text-sm font-semibold text-amber-700 dark:text-amber-300">Para obtener conclusiones comparables, selecciona productos activos de una misma categoría.</p>
      ) : (
        <div class="mt-4 space-y-4">
          {insights.price ? (
            <div class="rounded-xl bg-slate-50 p-4 dark:bg-slate-800">
              <h3 class="font-bold text-slate-900 dark:text-white">Menor precio registrado</h3>
              <p class="mt-1 text-sm text-slate-700 dark:text-slate-200">{insights.price.winners.map(item => item.name).join(' · ')} — {currencyCLP(insights.price.lowest)}</p>
              <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Diferencia entre el precio mayor y menor: {currencyCLP(insights.price.difference)} ({insights.price.percent.toLocaleString('es-CL', {maximumFractionDigits: 1})}% respecto del menor).</p>
            </div>
          ) : <p class="text-sm text-slate-600 dark:text-slate-300">No es posible comparar precios: faltan importes válidos.</p>}
          {insights.metrics.length > 0 ? (
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white">Mejores valores por criterio</h3>
              <ul class="mt-2 grid gap-3 md:grid-cols-2">
                {insights.metrics.map(metric => (
                  <li class="rounded-xl border border-slate-200 p-3 text-sm dark:border-slate-700">
                    <strong class="block text-slate-900 dark:text-white">{metric.label}</strong>
                    <span class="mt-1 block text-slate-700 dark:text-slate-200">{metric.winners.map(item => item.name).join(' · ')}</span>
                    <span class="mt-1 block text-xs text-slate-500 dark:text-slate-400">{metric.direction === 'menor' ? 'Menor valor' : 'Mayor valor'}: {metric.formulaType === 'precio_dividido_por' ? currencyCLPUnit(metric.value) : formatMetricValue(metric.value, 2)}</span>
                  </li>
                ))}
              </ul>
            </div>
          ) : <p class="text-sm text-slate-600 dark:text-slate-300">Sin métricas comunes suficientes para identificar un mejor valor unitario.</p>}
        </div>
      )}
      <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">Un precio inferior no implica mayor calidad. Compara tamaño, formato, características y condiciones del vendedor antes de decidir.</p>
    </section>
  )}

  {productos.length < 2 ? (
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
      Selecciona 2 a 4 productos desde una lista para comparar aquí.
    </div>
  ) : (
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
      <div class="overflow-x-auto" role="region" aria-label="Tabla comparativa; desliza horizontalmente para ver más productos" tabindex="0">
        <table class="min-w-full text-left">
          <thead class="bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-100">
            <tr>
              <th scope="col" class="sticky left-0 z-20 min-w-[140px] bg-slate-100 px-4 py-3 font-semibold dark:bg-slate-800">Métrica</th>
              {productos.map((producto) => (
                <th scope="col" class="px-4 py-3 font-semibold min-w-[180px]">
                  <a href={`/producto/${producto.id}`} class="text-emerald-600 hover:underline dark:text-emerald-400">{producto.nombre}</a>
                  <div class="mt-2 text-xs font-normal text-slate-500 dark:text-slate-300">{producto.marca || "Marca no indicada"}</div>
                  {/^https:\/\//i.test(String(producto.enlace_referido || "")) && (
                    <a href={producto.enlace_referido} data-affiliate-product={producto.id} data-affiliate-placement="comparison" target="_blank" rel="sponsored nofollow noopener" class="mt-2 inline-block rounded-lg bg-emerald-600 px-3 py-2 text-xs font-semibold text-white hover:bg-emerald-500">Ver oferta</a>
                  )}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            <tr class="border-t border-slate-200 dark:border-slate-800">
              <th scope="row" class="sticky left-0 z-10 bg-white px-4 py-3 font-medium dark:bg-slate-900">Precio</th>
              {productos.map((producto) => (
                <td class="px-4 py-3 font-bold">
                  <div>{currencyCLP(producto.precio)}</div>
                  <div class="text-xs font-normal text-slate-500 dark:text-slate-300">{getPrecioReferencialLabel(producto.fecha_precio)}</div>
                  {productHasOldPrice(producto.fecha_precio) ? <div class="text-xs font-normal text-amber-700 dark:text-amber-300">Precio posiblemente desactualizado</div> : null}
                </td>
              ))}
            </tr>
            {unionMetrics.map((clave) => {
              const defs = productos.flatMap((producto) => {
                const lista = catalog.getListaById(producto.lista_id);
                return lista?.metricas.filter((metrica) => metrica.clave === clave) ?? [];
              });
              const def = defs[0];
              if (!def) return null;
              const values = productos.map((producto) => {
                const lista = catalog.getListaById(producto.lista_id);
                const metric = lista?.metricas.find((item) => item.clave === clave);
                if (!metric) return null;
                return getMetricResult(producto, metric);
              });
              const compatible = mixedLists.size === 1 && defs.every((item) => JSON.stringify(item.plantilla ?? item.formula) === JSON.stringify(def.plantilla ?? def.formula));
              const bestValue = compatible ? getBestMetricValue(def.mejor, values) : null;
              return (
                <tr class="border-t border-slate-200 dark:border-slate-800">
                  <th scope="row" class="sticky left-0 z-10 bg-white px-4 py-3 font-medium dark:bg-slate-900">{def.etiqueta}</th>
                  {values.map((value, index) => (
                    <td class={`px-4 py-3 ${value !== null && bestValue !== null && value === bestValue ? 'bg-emerald-100 text-emerald-900 dark:bg-emerald-950 dark:text-emerald-200' : ''}`}>
                      {displayMetric(def, value)}
                    </td>
                  ))}
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  )}
</Layout>
