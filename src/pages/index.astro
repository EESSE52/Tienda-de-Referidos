---
import Layout from '../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
import { currencyCLP, loadCatalog } from '../lib/catalog';
import { AVISO_AFILIADOS_BREVE, getPublicProductImage, getPrecioReferencialLabel } from '../lib/public-site';
import { selectPopularProducts } from '../lib/popular-products.js';
import { selectPriceDrops } from '../lib/price-opportunities.js';

const catalog = await loadCatalog(env?.CATALOG_DB);
const bajasRegistradas = selectPriceDrops(catalog, 6);
let productosPopulares = [];
try {
  if (env?.CATALOG_DB?.prepare) {
    const since = new Date(Date.now() - 29 * 86400000).toISOString().slice(0, 10);
    const result = await env.CATALOG_DB.prepare(`
      SELECT product_id, SUM(count) AS visitas
      FROM analytics_daily
      WHERE day >= ? AND event_type = 'view'
      GROUP BY product_id
      ORDER BY visitas DESC
      LIMIT 50
    `).bind(since).all();
    productosPopulares = selectPopularProducts(result.results ?? [], catalog, 6);
  }
} catch {
  // Las estadísticas no son necesarias para que funcione la portada.
  productosPopulares = [];
}
const listaCards = catalog.listas.filter((lista) => lista.activa !== false).map((lista) => ({
  ...lista,
  productos: catalog.getProductosByListaId(lista.id),
}));
---

<Layout title="Comparador de precios y productos en Chile" description="Compara productos por precio, cantidad y características en D’MonkeySport. Revisa listas y ofertas referenciales en Chile.">
  <section class="mb-10 rounded-3xl bg-gradient-to-br from-emerald-500 to-teal-700 p-8 text-white shadow-lg shadow-emerald-200/30 dark:shadow-emerald-950/50">
    <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-emerald-100">D’MonkeySport</p>
    <h1 class="max-w-2xl text-4xl font-black tracking-tight">Comparador de productos, listas creadas por ti y precios claros.</h1>
    <p class="mt-4 max-w-2xl text-base text-emerald-50">
      Compara productos por mérito real, sin ruido ni promesas de salud: solo precio, cantidad, formato y métricas relevantes.
    </p>
    <p class="mt-4 inline-flex rounded-lg bg-white/20 px-3 py-2 text-sm text-emerald-50">{AVISO_AFILIADOS_BREVE}</p>
  </section>

  {bajasRegistradas.length > 0 && (
    <section aria-labelledby="price-drops-title" class="mb-10">
      <div class="mb-5">
        <p class="text-xs font-bold uppercase tracking-widest text-emerald-700 dark:text-emerald-400">Seguimiento de precios</p>
        <h2 id="price-drops-title" class="mt-1 text-2xl font-black text-slate-900 dark:text-white">Bajas de precio registradas</h2>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Cambios respecto del registro anterior de cada producto. No son descuentos ni disponibilidad confirmados por la tienda.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {bajasRegistradas.map(({ producto, cambio }) => (
          <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <a href={`/producto/${encodeURIComponent(producto.id)}`} class="block rounded-xl focus-visible:outline-2 focus-visible:outline-emerald-500">
              <img src={getPublicProductImage(producto)} alt={`Imagen referencial de ${producto.nombre}`} loading="lazy" width="480" height="320" class="h-36 w-full rounded-xl bg-slate-50 object-contain p-2 dark:bg-slate-800" />
              <p class="mt-3 text-xs font-bold text-emerald-700 dark:text-emerald-400">Bajó {cambio.percent.toLocaleString('es-CL', {maximumFractionDigits: 1})}% desde el registro anterior</p>
              <h3 class="mt-1 line-clamp-2 font-bold text-slate-900 dark:text-white">{producto.nombre}</h3>
              <p class="mt-2 text-lg font-black text-slate-900 dark:text-white">{currencyCLP(cambio.current)}</p>
              <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Antes: {currencyCLP(cambio.previous)} · Diferencia: {currencyCLP(cambio.difference)}</p>
              <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Registros: {cambio.previousDate} y {cambio.currentDate}. Verificar precio en tienda.</p>
              <span class="mt-3 inline-block text-sm font-bold text-emerald-700 dark:text-emerald-400">Ver historial y ficha →</span>
            </a>
          </article>
        ))}
      </div>
    </section>
  )}

  {productosPopulares.length > 0 && (
    <section aria-labelledby="popular-products-title" class="mb-10">
      <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-emerald-700 dark:text-emerald-400">Interés de los visitantes</p>
          <h2 id="popular-products-title" class="mt-1 text-2xl font-black text-slate-900 dark:text-white">Productos populares</h2>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Los más consultados en los últimos 30 días. Las visitas no representan ventas ni recomendaciones médicas.</p>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {productosPopulares.map(({ producto, visitas }) => (
          <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <a href={`/producto/${encodeURIComponent(producto.id)}`} class="block p-4 hover:bg-slate-50 focus-visible:outline-2 dark:hover:bg-slate-800">
              <img src={getPublicProductImage(producto)} alt={`Imagen referencial de ${producto.nombre}`} loading="lazy" width="480" height="320" class="h-40 w-full rounded-xl bg-slate-50 object-contain p-2 dark:bg-slate-800" />
              <p class="mt-3 text-xs font-semibold text-emerald-700 dark:text-emerald-400">{visitas.toLocaleString('es-CL')} visitas a la ficha</p>
              <h3 class="mt-1 line-clamp-2 text-lg font-bold text-slate-900 dark:text-white">{producto.nombre}</h3>
              <p class="mt-2 text-xl font-black text-slate-900 dark:text-white">{currencyCLP(producto.precio)}</p>
              <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">{getPrecioReferencialLabel(producto.fecha_precio)}</p>
              <span class="mt-3 inline-flex text-sm font-bold text-emerald-700 dark:text-emerald-400">Ver ficha y comparar →</span>
            </a>
          </article>
        ))}
      </div>
    </section>
  )}

  <section id="categorias" aria-label="Categorías de productos" class="grid scroll-mt-6 gap-6 md:grid-cols-2 xl:grid-cols-3">
    {listaCards.map((lista) => (
      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
        <div class="mb-4 flex items-start justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-emerald-600 dark:text-emerald-400">Lista</p>
            <h2 class="mt-2 text-2xl font-bold text-slate-900 dark:text-white">{lista.nombre}</h2>
          </div>
          <span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-700 dark:bg-emerald-900 dark:text-emerald-200">
            {lista.productos.length} productos
          </span>
        </div>

        <p class="mb-5 text-sm text-slate-600 dark:text-slate-300">{lista.descripcion}</p>

        <div class="mb-5 space-y-2 text-sm text-slate-700 dark:text-slate-200">
          <p><span class="font-semibold">Unidad base:</span> {lista.unidad_base}</p>
          <p><span class="font-semibold">Métricas:</span> {lista.metricas.length}</p>
        </div>

        <div class="mb-5 rounded-xl bg-slate-50 p-3 text-sm text-slate-700 dark:bg-slate-800 dark:text-slate-200">
          <div class="font-semibold text-slate-900 dark:text-white">Producto destacado</div>
          {lista.productos[0] ? (
            <div class="mt-2 flex items-center justify-between gap-4">
              <span>{lista.productos[0].nombre}</span>
              <strong>{currencyCLP(lista.productos[0].precio)}</strong>
            </div>
          ) : (
            <p class="mt-2 text-slate-500 dark:text-slate-400">Sin productos activos todavía.</p>
          )}
        </div>

        <a href={`/lista/${lista.slug}`} class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-700 dark:bg-emerald-500 dark:hover:bg-emerald-400 dark:text-slate-950">
          Ver lista
        </a>
      </article>
    ))}
  </section>

  <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-5 text-sm text-slate-700 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200">
    <p>
      Revisa la metodología completa en <a href="/como-comparamos" class="font-semibold text-emerald-600 hover:underline dark:text-emerald-400">Cómo comparamos</a> y el detalle en <a href="/aviso-afiliados" class="font-semibold text-emerald-600 hover:underline dark:text-emerald-400">Aviso de afiliados</a>.
    </p>
  </section>
</Layout>
